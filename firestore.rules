rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // HTVA Vk intentionally has no Firebase Authentication. Device IDs are
    // installation identifiers, not credentials. Client reads are denied;
    // teachers inspect submissions through the privileged Firebase Console.
    function validDeviceWrite(deviceId) {
      return request.auth == null
        && request.resource.data.device_id == deviceId;
    }

    match /HTVAData/{deviceId}/LEARNING_ATTEMPTS/{attemptId} {
      allow read: if false;
      allow create: if validDeviceWrite(deviceId)
        && request.resource.data.attempt_id == attemptId;
      allow update: if validDeviceWrite(deviceId)
        && resource.data.device_id == deviceId
        && request.resource.data.attempt_id == attemptId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "status", "submitted_at", "auto_submitted",
            "earned_automatic_score", "maximum_score", "correct_count",
            "incorrect_count", "unanswered_count", "pending_essay_count",
            "grading_status", "updated_at"
          ]);
      allow delete: if false;

      match /ANSWERS/{questionId} {
        allow read: if false;
        allow create, update: if validDeviceWrite(deviceId)
          && request.resource.data.question_id == questionId
          && request.resource.data.device_id == deviceId;
        allow delete: if false;
      }
    }

    match /HTVAData/{deviceId}/ESSAY_ATTEMPTS/{attemptId} {
      allow read: if false;
      allow create: if validDeviceWrite(deviceId)
        && request.resource.data.attempt_id == attemptId
        && request.resource.data.grading_status == "NOT_SUBMITTED";
      allow update: if validDeviceWrite(deviceId)
        && resource.data.device_id == deviceId
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["status", "submitted_at", "grading_status", "pending_submission_count"]);
      allow delete: if false;
    }

    match /HTVAData/{deviceId}/ESSAY_SUBMISSIONS/{submissionId} {
      allow read: if false;
      allow create: if validDeviceWrite(deviceId)
        && request.resource.data.device_id == deviceId
        && request.resource.data.awarded_score == null
        && request.resource.data.graded_at == null
        && request.resource.data.teacher_feedback == null
        && request.resource.data.status in ["DRAFT", "PENDING_REVIEW", "NOT_SUBMITTED"];
      allow update: if validDeviceWrite(deviceId)
        && resource.data.device_id == deviceId
        && resource.data.status == "DRAFT"
        && request.resource.data.awarded_score == null
        && request.resource.data.graded_at == null
        && request.resource.data.teacher_feedback == null
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "answer_text", "maximum_score", "status",
            "submitted_at", "updated_at"
          ]);
      allow delete: if false;
    }
  }
}
